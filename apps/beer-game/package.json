{
  "name": "@beer-game/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:u1": "vitest run tests/u1",
    "test:coverage": "vitest run tests/u1 --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "format:check": "prettier --check .",
    "e2e:u1": "playwright test tests/e2e/u1.spec.ts",
    "verify:u1": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run e2e:u1",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.0.6",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.6"
  }
}
