{
  "name": "@beer-game/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:u1": "vitest run tests/u1",
    "test:u2": "vitest run tests/u2",
    "test:u3": "vitest run tests/u3",
    "test:u4": "vitest run tests/u4",
    "test:u5": "vitest run tests/u5",
    "test:coverage": "vitest run tests/u1 tests/u2 tests/u3 tests/u4 tests/u5 --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "format:check": "prettier --check .",
    "e2e:u1": "playwright test tests/e2e/u1.spec.ts",
    "e2e:u5": "playwright test tests/e2e/u5.spec.ts",
    "e2e:u5:performance": "playwright test tests/e2e/u5-performance.spec.ts",
    "e2e:u5:matrix": "U5_BROWSER_MATRIX=1 playwright test tests/e2e/u5.spec.ts",
    "build:ui": "vite build",
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=3000 ALLOWED_ORIGIN=http://localhost:5173 RETENTION_HMAC_KEY=local-development-only-key API_RATE_LIMIT_PER_MINUTE=100000 tsx watch src/server.ts",
    "dev:bots": "tsx scripts/dev-bots.ts",
    "dev:client": "wait-on tcp:3000 && vite",
    "load:u5": "tsx performance/u5-load.ts",
    "load:u5:db": "tsx performance/u5-db-load.ts",
    "verify:u1": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run e2e:u1",
    "start": "tsx src/server.ts",
    "retention:coordinator": "tsx src/retention/worker-main.ts coordinator",
    "retention:owner": "tsx src/retention/worker-main.ts owner"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1162.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.0.6",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.6",
    "vitest": "^4.0.6",
    "wait-on": "^9.5.1"
  }
}
