# beer-game3 の環境変数の例。実際の値は .env（コミットしない）か秘密情報の管理から渡す。
# 接続先
DATABASE_URL=postgres://postgres:postgres@localhost:55432/beer_game3_dev
# 待ち受け
HOST=0.0.0.0
PORT=3100
# 鍵（形式: <鍵の識別子>:<base64 の 32 バイト>）。生成例: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# 起動のとき、どちらかが無い・不正なら起動しない。本番の鍵はここに書かない。
CODE_ENC_KEY=
CODE_HMAC_KEY=
# 鍵の入れ替えの間だけ、古い鍵を「,」区切りで並べる（復号と照合に使う。新規の保存には使わない）
CODE_ENC_KEY_PREVIOUS=
CODE_HMAC_KEY_PREVIOUS=
# 同じゲームの書き込みの順番待ちの上限（ミリ秒）。既定 3000
LOCK_TIMEOUT_MS=3000
# staging と production では true（HSTS を有効にする）
ENABLE_HSTS=false
# 画面の配信元（ビルド済みの画面）。既定 dist/web
WEB_DIST=dist/web
# 実行の環境: development（既定）、test、staging、production
APP_ENV=development
# 信頼するプロキシ（ロードバランサーなど）の段数。staging と production では必須（未設定なら起動しない）。
# 設定した段数の範囲でだけ転送元のヘッダを信じる。ALB の背後なら 1。開発では空（接続の相手のアドレスを使う）
TRUSTED_PROXY_HOPS=
# 復帰用 token の有効期間（最後の操作から、分）。既定 1440（24 時間）
RETURN_TOKEN_TTL_MINUTES=1440
# 最後の操作の時刻を書き込む最短の間隔（秒）。既定 60
TOKEN_TOUCH_INTERVAL_SECONDS=60
# 参加の無効な試行を数える窓（秒）と、窓に許す件数（超える試行を拒否する）。既定 60 秒、10 件
JOIN_WINDOW_SECONDS=60
JOIN_WINDOW_MAX_ATTEMPTS=10
# 窓の古い行を削除する周期（分）。既定 10
JOIN_SWEEP_INTERVAL_MINUTES=10
# 保持と自動終了（U5）。全ゲーム共通で、ゲームごとには持たない。範囲の外や整数でない値は起動しない
# 終了から削除までの日数（1〜3650）。既定 30。短くすると、すでに終了したゲームにも次の処理から適用される
RETENTION_DAYS=30
# 最後の操作から自動終了までの日数（1〜3650）。既定 30。準備中と一時停止中のゲームも対象
AUTO_END_DAYS=30
# 定期処理の間隔（分、1〜1440）。既定 60
RETENTION_JOB_INTERVAL_MINUTES=60
# 1 回の処理で、自動終了と削除のそれぞれに扱う上限（1〜1000）。既定 100
RETENTION_BATCH_LIMIT=100
