# beer-game-kotlin の開発環境タスク。`just` で一覧を表示する。
# 実行は apps/beer-game-kotlin で行う（リポジトリのルートからは `just -f apps/beer-game-kotlin/justfile <タスク>`）。

# 開発用のポート。vite.config.ts の既定（UI 5173、API 3000）と合わせる。
# 専用のポートで動かすときは環境変数で上書きする（例: API_PORT=3100 UI_PORT=5273 just dev）。
api_port := env("API_PORT", "3000")
ui_port := env("UI_PORT", "5173")

default:
    @just --list

# ---- バックエンド（Kotlin / Ktor）----

# バックエンドを起動する（APP_ENV=local・H2。DB 不要）
backend:
    APP_ENV=local DB_KIND=h2 PORT={{ api_port }} ./gradlew :app:run

# バックエンドの単体テスト
backend-test:
    ./gradlew test

# バックエンドの検査（ktlint・detekt・PMD・テスト）
backend-check:
    ./gradlew check

# ---- フロントエンド（React + Vite）----

# フロントエンドの依存を入れる
web-install:
    cd ../beer-game-web && npm ci

# フロントエンドの開発サーバーを起動する（/api は API_PORT へ中継）
web:
    cd ../beer-game-web && UI_PORT={{ ui_port }} API_PORT={{ api_port }} npm run dev

# フロントエンドの検証（format・lint・typecheck・test・build）
web-verify:
    cd ../beer-game-web && npm run verify

# ---- 両方 ----

# バックエンドとフロントエンドを同時に起動する（Ctrl-C で両方止まる）
dev:
    bash -c "trap 'kill 0' EXIT; just backend & just web & wait"

# ---- デモ環境（Heroku。手順は docs/operation/beer-game-kotlin/demo.md）----

# デモ環境のアプリを作り、Config Vars を合わせる（冪等）
demo-setup:
    scripts/demo.sh setup

# 手元からデモ環境へ配備する（build → push → release。ガードつき）
demo-deploy:
    scripts/demo.sh deploy

# デモ環境の状態（dyno・Config Vars・URL）
demo-status:
    scripts/demo.sh status

# デモ環境を再起動する（データは初期状態に戻る）
demo-restart:
    scripts/demo.sh restart

# デモ環境を停止する
demo-stop:
    scripts/demo.sh stop

# デモ環境を再開する
demo-start:
    scripts/demo.sh start
