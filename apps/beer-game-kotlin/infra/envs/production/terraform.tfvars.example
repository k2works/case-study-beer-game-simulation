# すべてダミーの値の例（実在のアカウント・ドメイン・バケット・リポジトリではない）。
# コピーして terraform.tfvars にし、値を入れる（terraform.tfvars はコミットしない）。
github_repository   = "<owner>/<repo>"
image               = "<ECR の URL>@sha256:<ステージングで検証した 64 桁のダイジェスト>"
web_bucket_name     = "<静的ファイルのバケット名（全世界で一意）>"
domain_name         = "<独自ドメイン>"
hosted_zone_id      = "<Route 53 のホストゾーン ID>"
# ステージングと同じアカウントなら false（OIDC プロバイダーは 1 アカウントに 1 つ）
create_oidc_provider = false
